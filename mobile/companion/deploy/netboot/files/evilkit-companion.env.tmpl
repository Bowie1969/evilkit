# EnvironmentFile for evilkit-companion.service (rendered from deploy.conf).
# Mode 0600, owned by the evilkit user. The token lives here, not on the
# command line, so it never appears in `ps`.
COMPANION_TOKEN=@@COMPANION_TOKEN@@
COMPANION_BIND=@@COMPANION_BIND@@
COMPANION_PORT=@@COMPANION_PORT@@
COMPANION_DATA_DIR=@@COMPANION_DATA_DIR@@
