[Unit]
Description=evilkit mobile companion (scope-gated pentest API)
Documentation=file:/opt/evilkit-companion/README
# Only reachable over the WireGuard tunnel: wait for it before binding.
After=network-online.target wg-quick@@@WG_IFACE@@.service
Wants=network-online.target
Requires=wg-quick@@@WG_IFACE@@.service

[Service]
Type=simple
User=evilkit
Group=evilkit
EnvironmentFile=/etc/evilkit/companion.env
Environment=PATH=/opt/evilkit-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /opt/evilkit-companion/server.py \
    --host ${COMPANION_BIND} \
    --port ${COMPANION_PORT} \
    --data-dir ${COMPANION_DATA_DIR}
Restart=on-failure
RestartSec=5
# If WireGuard drops and the interface address disappears, the bind fails and
# the restart loop keeps retrying until the tunnel is back -- fail closed.

# --- sandboxing -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@@COMPANION_DATA_DIR@@
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# nmap needs raw sockets for SYN scans; grant only what the tools require.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
