# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Never commit a real project config: it holds authorized scopes and tokens.
# Backups, mkstemp staging files and the sidecar lock file are written beside
# the target, so every pattern has to cover any *.mcp.json basename and not
# just the default ".mcp.json".
.mcp.json
*.mcp.json
.mcp.json.*.bak
*.mcp.json.*.bak
.mcp.json.new
*.mcp.json.new
.mcp.json.*.new
*.mcp.json.*.new
.mcp.json.lock
*.mcp.json.lock

# Local secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.env
.netrc
id_rsa
id_ed25519
id_ecdsa
id_dsa

# Editors and OS cruft
.DS_Store
.idea/
.vscode/
*.swp
